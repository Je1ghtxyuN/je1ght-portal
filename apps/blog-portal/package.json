{
  "name": "blog-portal",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "hexo server",
    "build": "hexo clean && hexo generate",
    "clean": "hexo clean",
    "deploy": "hexo deploy",
    "test": "node --test test/*.test.js",
    "validate": "node lib/portal/validate-output.js public",
    "check": "npm test && npm run build && npm run validate",
    "home:custom": "node -e \"var f='scripts/portal-home-generator.js',d='scripts/_disabled';require('fs').existsSync(d+'/portal-home-generator.js')&&require('fs').renameSync(d+'/portal-home-generator.js',f);console.log('Homepage: custom template')\"",
    "home:default": "node -e \"var f='scripts/portal-home-generator.js',d='scripts/_disabled';require('fs').mkdirSync(d,{recursive:true});require('fs').existsSync(f)&&require('fs').renameSync(f,d+'/portal-home-generator.js');console.log('Homepage: Butterfly default (edit source/index.md: set layout: index, remove type and tag)')\""
  },
  "hexo": {
    "version": "7.3.0"
  },
  "dependencies": {
    "hexo": "^7.3.0",
    "hexo-cli": "^4.3.2",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-searchdb": "^1.4.1",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-marked": "^7.0.1",
    "hexo-renderer-pug": "^3.0.0",
    "hexo-server": "^3.0.0",
    "hexo-theme-butterfly": "^5.5.4",
    "hexo-util": "^3.3.0",
    "hexo-wordcount": "^6.0.1"
  }
}
