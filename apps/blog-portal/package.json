{
  "name": "blog-portal",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "hexo server",
    "build": "hexo clean && hexo generate",
    "clean": "hexo clean",
    "deploy": "hexo deploy",
    "test": "node --test test/*.test.js",
    "test:generated-output": "PORTAL_BUILD_VERSION=$(git rev-parse --short HEAD) npm run build && PORTAL_BUILD_VERSION=$(git rev-parse --short HEAD) node --test test/generated-output/butterfly-pages-output.test.js",
    "validate": "node lib/portal/validate-output.js public",
    "check": "npm test && npm run test:generated-output && npm run validate"
  },
  "hexo": {
    "version": "7.3.0"
  },
  "dependencies": {
    "hexo": "^7.3.0",
    "hexo-cli": "^4.3.2",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-searchdb": "^1.4.1",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-marked": "^7.0.1",
    "hexo-renderer-pug": "^3.0.0",
    "hexo-server": "^3.0.0",
    "hexo-theme-butterfly": "^5.5.4",
    "hexo-util": "^3.3.0",
    "hexo-wordcount": "^6.0.1"
  }
}
